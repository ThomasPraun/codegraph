{
  "ts": {
    "label": "TypeScript / JavaScript",
    "exts": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs"
    ],
    "line": [
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\"",
      "'",
      "`"
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*export[ \\t]+(?:default[ \\t]+)?(?:declare[ \\t]+)?(?:abstract[ \\t]+)?(?:async[ \\t]+)?(function\\*?|class|interface|type|enum|const|let|var)[ \\t]+([A-Za-z_$][\\w$]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "import\\s+([\\s\\S]*?)\\s+from\\s*['\"]([^'\"]+)['\"]",
        "spec": 2,
        "clause": 1,
        "style": "braced"
      },
      {
        "re": "import\\s*['\"]([^'\"]+)['\"]",
        "spec": 1
      },
      {
        "re": "(?:const|let|var)\\s+(\\{[^}]*\\}|[A-Za-z_$][\\w$]*)\\s*=\\s*require\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)",
        "spec": 2,
        "clause": 1,
        "style": "braced"
      }
    ],
    "resolve": {
      "index": true,
      "aliasRoots": [
        "src",
        "lib"
      ]
    }
  },
  "astro": {
    "label": "Astro",
    "exts": [
      ".astro"
    ],
    "line": [
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ],
      [
        "<!--",
        "-->"
      ]
    ],
    "strings": [
      "\"",
      "'",
      "`"
    ],
    "body": "braces",
    "doc": "above",
    "fileIsComponent": true,
    "decls": [
      {
        "re": "^[ \\t]*export[ \\t]+(?:default[ \\t]+)?(?:declare[ \\t]+)?(?:abstract[ \\t]+)?(?:async[ \\t]+)?(function\\*?|class|interface|type|enum|const|let|var)[ \\t]+([A-Za-z_$][\\w$]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "import\\s+([\\s\\S]*?)\\s+from\\s*['\"]([^'\"]+)['\"]",
        "spec": 2,
        "clause": 1,
        "style": "braced"
      },
      {
        "re": "import\\s*['\"]([^'\"]+)['\"]",
        "spec": 1
      }
    ],
    "resolve": {
      "index": true,
      "aliasRoots": [
        "src",
        "lib"
      ]
    }
  },
  "dart": {
    "label": "Dart / Flutter",
    "exts": [
      ".dart"
    ],
    "line": [
      "///",
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\"",
      "'"
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?:(?:abstract|sealed|final|base|interface|mixin)[ \\t]+)*(class|mixin|enum|extension|typedef)[ \\t]+([A-Za-z_$][\\w$]*)",
        "kind": 1,
        "name": 2
      },
      {
        "re": "^[ \\t]*(?!(?:if|for|while|switch|catch|return|else|do|try|await|yield|assert|throw|new|class|mixin|enum|extension|typedef|abstract|sealed|interface|base)\\b)(?:(?:static|final|const|late|external|covariant)[ \\t]+)*[A-Za-z_$][\\w$<>,.\\s[\\]?]*?[ \\t]+(?:(?:get|set)[ \\t]+)?([A-Za-z_$][\\w$]*)[ \\t]*(?:\\([^)]*\\))?[ \\t]*(?:async[ \\t]*\\*?[ \\t]*)?(?:\\{|=>)",
        "kind": "method",
        "name": 1
      }
    ],
    "imports": [
      {
        "re": "(?:import|export|part)\\s+['\"]([^'\"]+)['\"]([^;]*);",
        "spec": 1,
        "clause": 2,
        "style": "show"
      }
    ],
    "resolve": {
      "packagePrefix": "package:",
      "packageDropSegments": 1,
      "packageRoot": "lib"
    },
    "docSkip": "^[ \\t]*@"
  },
  "python": {
    "label": "Python",
    "exts": [
      ".py",
      ".pyi"
    ],
    "line": [
      "#"
    ],
    "block": [],
    "blockStrings": [
      [
        "\"\"\"",
        "\"\"\""
      ],
      [
        "'''",
        "'''"
      ]
    ],
    "strings": [
      "\"",
      "'"
    ],
    "body": "indent",
    "doc": "below",
    "decls": [
      {
        "re": "^[ \\t]*(?:async[ \\t]+)?(def|class)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*from[ \\t]+([\\w.]+)[ \\t]+import[ \\t]+([^\\n]+)",
        "spec": 1,
        "clause": 2,
        "style": "list"
      },
      {
        "re": "^[ \\t]*import[ \\t]+([\\w.]+)",
        "spec": 1
      }
    ],
    "resolve": {
      "specSep": ".",
      "index": true,
      "indexName": "__init__",
      "aliasRoots": [
        "src",
        "lib"
      ]
    },
    "docSkip": "^[ \\t]*@"
  },
  "go": {
    "label": "Go",
    "exts": [
      ".go"
    ],
    "line": [
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\"",
      "`"
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^func[ \\t]+(?:\\([^)]*\\)[ \\t]*)?([A-Z][\\w]*)",
        "kind": "function",
        "name": 1
      },
      {
        "re": "^type[ \\t]+([A-Z][\\w]*)",
        "kind": "type",
        "name": 1
      },
      {
        "re": "^(?:var|const)[ \\t]+([A-Z][\\w]*)",
        "kind": "const",
        "name": 1
      }
    ],
    "imports": [
      {
        "re": "import[ \\t]+\"([^\"]+)\"",
        "spec": 1
      },
      {
        "re": "import[ \\t]*\\(([\\s\\S]*?)\\)",
        "specsFrom": 1
      }
    ],
    "resolve": {
      "lastSegments": true
    }
  },
  "rust": {
    "label": "Rust",
    "exts": [
      ".rs"
    ],
    "line": [
      "///",
      "//!",
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\""
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*pub(?:\\([^)]*\\))?[ \\t]+(?:async[ \\t]+)?(?:unsafe[ \\t]+)?(?:const[ \\t]+)?(fn|struct|enum|trait|type|static|mod|union)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*(?:pub[ \\t]+)?use[ \\t]+([^;]+);",
        "spec": 1,
        "clause": 1,
        "style": "pathBraced"
      }
    ],
    "resolve": {
      "specSep": "::",
      "stripSpecPrefixes": [
        "crate",
        "self",
        "super"
      ],
      "aliasRoots": [
        "src"
      ],
      "index": true,
      "indexName": "mod"
    },
    "docSkip": "^[ \\t]*#\\["
  },
  "ruby": {
    "label": "Ruby",
    "exts": [
      ".rb"
    ],
    "line": [
      "#"
    ],
    "block": [],
    "strings": [
      "\"",
      "'"
    ],
    "body": "none",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(class|module)[ \\t]+([A-Z][\\w:]*)",
        "kind": 1,
        "name": 2
      },
      {
        "re": "^[ \\t]*(def)[ \\t]+(?:self\\.)?([a-zA-Z_][\\w]*[?!]?)",
        "kind": "function",
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "require(?:_relative)?[ \\t]+['\"]([^'\"]+)['\"]",
        "spec": 1
      }
    ],
    "resolve": {
      "aliasRoots": [
        "lib",
        "app"
      ]
    }
  },
  "java": {
    "label": "Java",
    "exts": [
      ".java"
    ],
    "line": [
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\""
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?![^\\n]*\\bprivate\\b)(?:(?:public|protected|static|final|abstract|sealed|non-sealed)[ \\t]+)*(class|interface|enum|record)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      },
      {
        "re": "^[ \\t]+(?![^\\n]*\\bprivate\\b)(?!(?:if|for|while|switch|catch|return|else|do|try|new|throw|case)\\b)(?:(?:public|protected|static|final|synchronized|abstract|default|native)[ \\t]+)*[A-Za-z_][\\w<>\\[\\],.?]*[ \\t]+([a-z][\\w]*)[ \\t]*\\(",
        "kind": "method",
        "name": 1
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*import[ \\t]+(?:static[ \\t]+)?([\\w.]+)[ \\t]*;",
        "spec": 1,
        "clause": 1,
        "style": "lastSegment"
      }
    ],
    "resolve": {
      "specSep": ".",
      "aliasRoots": [
        "src/main/java",
        "src",
        "app/src/main/java"
      ]
    },
    "docSkip": "^[ \\t]*@"
  },
  "kotlin": {
    "label": "Kotlin",
    "exts": [
      ".kt",
      ".kts"
    ],
    "line": [
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\""
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?![^\\n]*\\bprivate\\b)(?:(?:public|internal|protected|open|abstract|sealed|data|inline|suspend|override|final|value|annotation|external|tailrec|operator)[ \\t]+)*(fun|class|object|interface|typealias)[ \\t]+(?:<[^>]*>[ \\t]*)?(?:[A-Za-z_][\\w]*(?:<[^>]*>)?\\??\\.)?([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*import[ \\t]+([\\w.]+)",
        "spec": 1,
        "clause": 1,
        "style": "lastSegment"
      }
    ],
    "resolve": {
      "specSep": ".",
      "aliasRoots": [
        "src/main/kotlin",
        "src"
      ]
    },
    "docSkip": "^[ \\t]*@"
  },
  "swift": {
    "label": "Swift",
    "exts": [
      ".swift"
    ],
    "line": [
      "///",
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\""
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?![^\\n]*\\b(?:private|fileprivate)\\b)(?:(?:public|open|internal|final|static|class|override|mutating|indirect|@[\\w()]+)[ \\t]+)*(func|class|struct|enum|protocol|actor|typealias)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      },
      {
        "re": "^[ \\t]*(?![^\\n]*\\b(?:private|fileprivate)\\b)(?:(?:public|open|internal|final|static|class|override|lazy|weak|unowned|@[\\w()]+)[ \\t]+)*(var|let)[ \\t]+([A-Za-z_][\\w]*)[ \\t]*:",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*import[ \\t]+([\\w.]+)",
        "spec": 1
      }
    ],
    "resolve": {
      "aliasRoots": [
        "Sources",
        "src"
      ]
    },
    "docSkip": "^[ \\t]*@"
  },
  "php": {
    "label": "PHP",
    "exts": [
      ".php"
    ],
    "line": [
      "//",
      "#"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\"",
      "'"
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?![^\\n]*\\bprivate\\b)(?:(?:abstract|final|public|protected|readonly|static)[ \\t]+)*(function|class|interface|trait|enum)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*use[ \\t]+([\\w\\\\]+)",
        "spec": 1,
        "clause": 1,
        "style": "lastSegment"
      },
      {
        "re": "require(?:_once)?[ \\t]*\\(?[ \\t]*['\"]([^'\"]+)['\"]",
        "spec": 1
      }
    ],
    "resolve": {
      "specSep": "\\",
      "aliasRoots": [
        "src",
        "app",
        "lib"
      ]
    },
    "docSkip": "^[ \\t]*#\\["
  },
  "csharp": {
    "label": "C#",
    "exts": [
      ".cs"
    ],
    "line": [
      "///",
      "//"
    ],
    "block": [
      [
        "/*",
        "*/"
      ]
    ],
    "strings": [
      "\""
    ],
    "body": "braces",
    "doc": "above",
    "decls": [
      {
        "re": "^[ \\t]*(?![^\\n]*\\bprivate\\b)(?:(?:public|internal|protected|static|sealed|abstract|partial|readonly|file)[ \\t]+)*(class|interface|struct|enum|record|delegate)[ \\t]+([A-Za-z_][\\w]*)",
        "kind": 1,
        "name": 2
      },
      {
        "re": "^[ \\t]+(?![^\\n]*\\bprivate\\b)(?!(?:if|for|foreach|while|switch|catch|return|else|do|try|new|throw|using|lock|fixed|await|yield|var|in|is|as|checked|unchecked)\\b)(?:(?:public|internal|protected|static|virtual|override|abstract|sealed|async|extern|unsafe|partial|new|readonly)[ \\t]+)*[A-Za-z_][\\w<>\\[\\],.?]*[ \\t]+([A-Za-z_][\\w]*)[ \\t]*\\(",
        "kind": "method",
        "name": 1
      }
    ],
    "imports": [
      {
        "re": "^[ \\t]*using[ \\t]+(?:static[ \\t]+)?([\\w.]+)[ \\t]*;",
        "spec": 1,
        "clause": 1,
        "style": "lastSegment"
      }
    ],
    "resolve": {
      "specSep": ".",
      "aliasRoots": [
        "src"
      ]
    },
    "docSkip": "^[ \\t]*\\["
  }
}
